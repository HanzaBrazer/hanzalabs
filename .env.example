# Copy this file to ".env.local" and fill in the values.

# Resend API key — create a free one at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Where contact-form submissions are delivered
CONTACT_TO_EMAIL=you@example.com

# Optional sender. Default (onboarding@resend.dev) works for testing and can
# deliver to your own Resend account email. Use a verified-domain address for
# production, e.g. HanzaLabs <hello@yourdomain.com>
# CONTACT_FROM_EMAIL=HanzaLabs <onboarding@resend.dev>
